    "FEATURES_NUM = PRIMARY_NUM\n",
    "FEATURES_BIN = PRIMARY_BIN\n",
    "FEATURES_CAT = PRIMARY_CAT + DERIVED_CAT\n",
    "FEATURES = FEATURES_NUM + FEATURES_BIN + FEATURES_CAT\n",
    "assert not set(FEATURES) & ({TARGET_REG, TARGET_CLF} | set(LEAKY_COLUMNS) | set(NOT_PRIMARY)), \"leakage in feature list\"\n",
    "\n",
    "def make_preprocessor(scale=True):\n",
    "    # fit() on training rows learns the scaling and the category lists; transform() reuses them unchanged\n",
    "    num_step = StandardScaler() if scale else \"passthrough\"\n",
    "    return ColumnTransformer([\n",
    "        (\"num\", num_step, FEATURES_NUM),\n",
    "        (\"bin\", \"passthrough\", FEATURES_BIN),\n",
    "        (\"cat\", OneHotEncoder(handle_unknown=\"infrequent_if_exist\", min_frequency=10, sparse_output=False), FEATURES_CAT),\n",
    "    ])\n",
    "\n",
    "X = {k: p[FEATURES] for k, p in parts.items()}\n",
    "y_reg = {k: p[TARGET_REG] for k, p in parts.items()}\n",
    "y_clf = {k: p[TARGET_CLF] for k, p in parts.items()}\n",
    "assert all(int(x.isna().sum().sum()) == 0 for x in X.values()), \"NaN left in predictors\"\n",
    "\n",
    "prep_scaled = make_preprocessor(scale=True).fit(X[\"train\"])        # SVM / KNN / linear / naive Bayes\n",
    "prep_trees = make_preprocessor(scale=False).fit(X[\"train\"])        # decision tree (no scaling needed)\n",
    "Xs = {k: prep_scaled.transform(v) for k, v in X.items()}\n",
    "Xt = {k: prep_trees.transform(v) for k, v in X.items()}\n",
    "feature_names = prep_scaled.get_feature_names_out()\n",
    "\n",
    "print(\"shared predictor set:\", len(FEATURES), \"columns ->\", Xs[\"train\"].shape[1], \"model inputs after one-hot encoding\")\n",
    "print({k: v.shape for k, v in Xs.items()})\n",
    "scaled_train = pd.DataFrame(Xs[\"train\"][:, :len(FEATURES_NUM)], columns=FEATURES_NUM)\n",
    "print(\"\\nscaled numeric inputs on TRAIN: mean ~ 0, std ~ 1 (as expected)\")\n",
    "display(scaled_train.agg([\"mean\", \"std\"]).round(3))\n",
    "print(\"same fitted scaler applied to VALIDATION (not re-fit, so mean/std are only close to 0/1):\")\n",
    "display(pd.DataFrame(Xs[\"val\"][:, :len(FEATURES_NUM)], columns=FEATURES_NUM).agg([\"mean\", \"std\"]).round(3))\n",
    "print(\"\\nfirst 3 model-input rows (train, scaled):\")\n",
    "display(pd.DataFrame(Xs[\"train\"][:3], columns=feature_names).iloc[:, :14].round(2))\n",
    "\n",
    "# ---- leakage / integrity checks after cleaning\n",
    "keys = {k: p[PRIMARY_RAW].astype(str).agg(\"|\".join, axis=1) for k, p in parts.items()}\n",
    "cross = {f\"{a}-{b}\": len(set(keys[a]) & set(keys[b])) for a, b in [(\"train\", \"val\"), (\"train\", \"test\"), (\"val\", \"test\")]}\n",
    "print(\"\\nidentical cleaned predictor records shared between partitions:\", cross)\n",
    "print(\"partition row overlap:\", len(set(parts[\"train\"].index) & set(parts[\"val\"].index)) + len(set(parts[\"train\"].index) & set(parts[\"test\"].index)) + len(set(parts[\"val\"].index) & set(parts[\"test\"].index)))\n",
    "assert int(pd.util.hash_pandas_object(raw_data, index=True).sum()) == raw_fingerprint, \"raw_data changed!\"\n",
    "print(\"raw_data fingerprint unchanged: True\")\n",
