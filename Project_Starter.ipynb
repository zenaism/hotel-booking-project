    "# ============ 1) declare targets and predictor columns ============\n",
    "TARGET_REG = \"adr\"\n",
    "TARGET_CLF = \"is_canceled\"\n",
    "LEAKY_COLUMNS = [\"reservation_status\", \"reservation_status_date\"]          # reveal the outcome -> never inputs\n",
    "NOT_PRIMARY = [\"assigned_room_type\", \"booking_changes\", \"deposit_type\", \"days_in_waiting_list\",\n",
    "               \"required_car_parking_spaces\", \"total_of_special_requests\"]  # timing unclear -> left out of main comparison\n",
    "\n",
    "PRIMARY_NUM = [\"lead_time\", \"arrival_date_year\", \"arrival_date_week_number\", \"arrival_date_day_of_month\",\n",
    "               \"stays_in_weekend_nights\", \"stays_in_week_nights\", \"adults\", \"children\", \"babies\",\n",
    "               \"previous_cancellations\", \"previous_bookings_not_canceled\"]\n",
    "PRIMARY_BIN = [\"is_repeated_guest\"]\n",
    "PRIMARY_CAT = [\"hotel\", \"arrival_date_month\", \"meal\", \"market_segment\", \"distribution_channel\",\n",
    "               \"reserved_room_type\", \"customer_type\"]\n",
    "DERIVED_CAT = [\"arrival_weekday\"]                      # built in P4 from the validated arrival date\n",
    "EXTENSION_CAT = [\"country\", \"agent\", \"company\"]        # explored as optional extensions only\n",
    "\n",
    "PRIMARY_RAW = PRIMARY_NUM + PRIMARY_BIN + PRIMARY_CAT  # raw columns that define \"identical predictor records\"\n",
    "assert not set(PRIMARY_RAW + DERIVED_CAT) & ({TARGET_REG, TARGET_CLF} | set(LEAKY_COLUMNS) | set(NOT_PRIMARY))\n",
    "\n",
    "# ============ 2) fixed eligibility rules (no learning from data, no target-based thresholds) ============\n",
    "cleaning_log = []\n",
    "def log_step(task, issue, affected, decision, reason, rows_after):\n",
    "    cleaning_log.append({\"task\": task, \"issue\": issue, \"affected_rows\": affected,\n",
    "                         \"decision\": decision, \"reason\": reason, \"rows_after\": rows_after})\n",
    "\n",
    "children_num = pd.to_numeric(raw_data[\"children\"], errors=\"coerce\")           # 'NA' -> NaN (unknown)\n",
    "total_nights = raw_data[\"stays_in_weekend_nights\"] + raw_data[\"stays_in_week_nights\"]\n",
    "total_guests = raw_data[\"adults\"] + children_num + raw_data[\"babies\"]           # NaN if children unknown\n",
    "\n",
    "eligibility_rules = [\n",
    "    (\"Negative ADR\", raw_data[\"adr\"] < 0,\n",
    "     \"A nightly rate below zero cannot be a real price (looks like a refund / entry error).\"),\n",
    "    (\"Zero nights booked\", total_nights == 0,\n",
    "     \"A stay with 0 weekend and 0 week nights is not a real stay, and every one of these rows has adr = 0.\"),\n",
    "    (\"Zero guests (all known counts are 0)\", total_guests == 0,\n",
    "     \"A booking with nobody staying is not a valid booking. Rows where children is unknown are NOT dropped here.\"),\n",
    "]\n",
    "keep = pd.Series(True, index=raw_data.index)\n",
    "for name, mask, why in eligibility_rules:\n",
    "    newly_removed = int((mask & keep).sum())\n",
    "    keep &= ~mask\n",
    "    log_step(\"Eligibility (before split)\", name, newly_removed, \"Exclude from the modeling pool\", why, int(keep.sum()))\n",
    "eligible_idx = raw_data.index[keep]\n",
    "print(f\"Eligible records after fixed rules: {len(eligible_idx):,} of {len(raw_data):,}\")\n",
    "\n",
    "# ============ 3) reproducible modeling sample (up to 5,000 rows) ============\n",
    "SAMPLE_SIZE = 5000\n",
    "rng = np.random.RandomState(RANDOM_STATE)\n",
    "sample_idx = np.sort(rng.choice(eligible_idx.values, size=min(SAMPLE_SIZE, len(eligible_idx)), replace=False))\n",
    "log_step(\"Sampling\", \"Full data is large for SVM/KNN tuning\", len(eligible_idx) - len(sample_idx),\n",
    "         \"Simple random sample of 5,000 eligible rows (seed 432)\", \"Keeps model comparisons manageable; stratification is done in the split.\",\n",
    "         len(sample_idx))\n",
    "print(f\"Modeling sample: {len(sample_idx):,} rows (source row indexes saved below)\")\n",
    "\n",
    "# ============ 4) identical-predictor groups (targets are NOT used) ============\n",
    "key_df = raw_data.loc[sample_idx, PRIMARY_RAW].copy()\n",
    "key_df[\"meal\"] = key_df[\"meal\"].replace({\"Undefined\": \"SC\"})        # same meaning in the dictionary -> same group\n",
    "group_id = pd.Series(pd.factorize(key_df.astype(str).agg(\"|\".join, axis=1))[0], index=sample_idx, name=\"group_id\")\n",
    "y_sample = raw_data.loc[sample_idx, TARGET_CLF]                       # only used to stratify\n",
    "\n",
    "# ============ 5) 60 / 20 / 20 split: 5 stratified, group-aware folds -> 3 train, 1 val, 1 test ============\n",
    "sgkf = StratifiedGroupKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
    "folds = [fold_idx for _, fold_idx in sgkf.split(sample_idx, y_sample.values, group_id.values)]\n",
    "pos_test, pos_val = folds[0], folds[1]\n",
    "pos_train = np.concatenate(folds[2:])\n",
    "\n",
    "partition_index = {\"train\": np.sort(sample_idx[pos_train]),\n",
    "                   \"val\":   np.sort(sample_idx[pos_val]),\n",
    "                   \"test\":  np.sort(sample_idx[pos_test])}\n",
    "\n",
    "# ============ 6) checks: no overlap, sizes, class proportions ============\n",
    "names = list(partition_index)\n",
    "for i in range(3):\n",
    "    for j in range(i + 1, 3):\n",
    "        a, b = names[i], names[j]\n",
    "        row_overlap = len(set(partition_index[a]) & set(partition_index[b]))\n",
    "        grp_overlap = len(set(group_id[partition_index[a]]) & set(group_id[partition_index[b]]))\n",
    "        print(f\"{a:>5} vs {b:<5} -> shared rows: {row_overlap}, shared predictor groups: {grp_overlap}\")\n",
    "assert sum(len(v) for v in partition_index.values()) == len(sample_idx)\n",
    "\n",
    "summary = pd.DataFrame({\n",
    "    \"rows\": {k: len(v) for k, v in partition_index.items()},\n",
    "    \"share_of_sample\": {k: round(len(v) / len(sample_idx), 3) for k, v in partition_index.items()},\n",
    "    \"canceled_rate\": {k: round(raw_data.loc[v, TARGET_CLF].mean(), 3) for k, v in partition_index.items()},\n",
    "    \"predictor_groups\": {k: group_id[v].nunique() for k, v in partition_index.items()},\n",
    "})\n",
    "summary.loc[\"whole sample\"] = [len(sample_idx), 1.0, round(y_sample.mean(), 3), group_id.nunique()]\n",
    "display(summary)\n",
    "print(\"sample rows that share their predictor values with another sampled row:\",\n",
    "      int((group_id.map(group_id.value_counts()) > 1).sum()))\n",
    "\n",
    "# ============ 7) save membership so every model reuses the same records ============\n",
    "split_membership = pd.concat([pd.DataFrame({\"source_row_index\": v, \"partition\": k}) for k, v in partition_index.items()])\n",
    "split_membership[\"group_id\"] = group_id.loc[split_membership[\"source_row_index\"]].values\n",
    "split_membership = split_membership.sort_values(\"source_row_index\").reset_index(drop=True)\n",
    "split_membership.to_csv(\"split_membership.csv\", index=False)\n",
    "print(\"saved split_membership.csv\")\n",
    "display(split_membership.head())"
   ]
  },
