   "source": [
    "# working copies for each partition - raw_data itself is never modified\n",
    "parts = {name: raw_data.loc[idx].copy() for name, idx in partition_index.items()}\n",
    "\n",
    "# literal texts that really mean \"we don't know this value\"\n",
    "UNKNOWN_TOKENS = {\"children\": \"NA\", \"country\": \"NULL\",\n",
    "                  \"market_segment\": \"Undefined\", \"distribution_channel\": \"Undefined\"}\n",
    "\n",
    "def count_unknown(df):\n",
    "    return pd.Series({c: int((df[c].astype(str) == t).sum()) for c, t in UNKNOWN_TOKENS.items()})\n",
    "\n",
    "missing_before = pd.DataFrame({\"all raw rows\": count_unknown(raw_data),\n",
    "                               \"train\": count_unknown(parts[\"train\"]),\n",
    "                               \"val\": count_unknown(parts[\"val\"]),\n",
    "                               \"test\": count_unknown(parts[\"test\"])})\n",
    "missing_before.index = [f\"{c}  (literal '{t}')\" for c, t in UNKNOWN_TOKENS.items()]\n",
    "print(\"Unknown values by column, before any treatment:\")\n",
    "display(missing_before)\n",
    "\n",
    "print(\"real empty / NaN cells anywhere in raw_data:\", int(raw_data.isna().sum().sum() + (raw_data == \"\").sum().sum()))\n",
    "print(\"missing target labels (adr / is_canceled):\", int(raw_data[[TARGET_REG, TARGET_CLF]].isna().sum().sum()), \"-> nothing to impute, targets are never imputed\")\n",
    "\n",
    "print(\"\\nThe 4 raw rows where children is 'NA':\")\n",
    "display(raw_data.loc[raw_data[\"children\"] == \"NA\", [\"hotel\", \"arrival_date_year\", \"adults\", \"children\", \"babies\", \"market_segment\"]])\n",
    "\n",
    "# ---- treatment: turn the unknown texts into real NaN, then fill using rules learned on TRAIN only\n",
    "for df in parts.values():\n",
    "    for c, t in UNKNOWN_TOKENS.items():\n",
    "        df[c] = df[c].mask(df[c].astype(str) == t)\n",
    "    df[\"children\"] = pd.to_numeric(df[\"children\"])\n",
    "\n",
    "impute_values = {                                               # learned from the training partition only\n",
    "    \"children\": int(parts[\"train\"][\"children\"].mode().iloc[0]),\n",
    "    \"market_segment\": parts[\"train\"][\"market_segment\"].mode().iloc[0],\n",
    "    \"distribution_channel\": parts[\"train\"][\"distribution_channel\"].mode().iloc[0],\n",
    "}\n",
    "print(\"\\nImputation values learned from training data:\", impute_values)\n",
    "\n",
    "for df in parts.values():\n",
    "    for c, v in impute_values.items():\n",
    "        df[c] = df[c].fillna(v)\n",
    "    df[\"country\"] = df[\"country\"].fillna(\"Unknown\")             # kept as its own label, see explanation\n",
    "\n",
    "missing_after = pd.DataFrame({k: v.isna().sum() for k, v in parts.items()})\n",
    "print(\"\\nNaN cells left after treatment (should be all 0):\", int(missing_after.values.sum()))\n",
    "n_rows = sum(len(p) for p in parts.values())\n",
    "\n",
    "n_all = missing_before[\"all raw rows\"]\n",
    "n_smp = missing_before[[\"train\", \"val\", \"test\"]].sum(axis=1)\n",
    "log_step(\"P1 missing values\", \"children = 'NA' (unknown)\", int(n_smp.iloc[0]),\n",
    "         \"Fill with training-set mode (0) - rule applied to all partitions\",\n",
    "         f\"{int(n_all.iloc[0])} rows in the full file, none landed in the 5,000-row sample; rule kept so the pipeline still works on new rows.\", n_rows)\n",
    "log_step(\"P1 missing values\", \"country = 'NULL' (unknown)\", int(n_smp.iloc[1]),\n",
    "         \"Keep as its own label 'Unknown'\",\n",
    "         f\"{int(n_all.iloc[1])} rows in full file. Filling with the most common country (PRT) would invent information; country is only an extension variable.\", n_rows)\n",
    "log_step(\"P1 missing values\", \"market_segment = 'Undefined'\", int(n_smp.iloc[2]),\n",
    "         \"Fill with training-set mode - rule applied to all partitions\",\n",
    "         f\"{int(n_all.iloc[2])} rows in full file, none in the sample; mode learned on train only.\", n_rows)\n",
    "log_step(\"P1 missing values\", \"distribution_channel = 'Undefined'\", int(n_smp.iloc[3]),\n",
    "         \"Fill with training-set mode - rule applied to all partitions\",\n",
    "         f\"{int(n_all.iloc[3])} rows in full file, none in the sample; mode learned on train only.\", n_rows)\n",
    "log_step(\"P1 missing values\", \"Missing target labels\", 0, \"Nothing to do\", \"adr and is_canceled have no empty cells; targets are never imputed.\", n_rows)"
