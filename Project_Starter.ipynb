    "ax[0, 0].axvline(train[\"adr\"].median(), color=\"black\", ls=\"--\", label=f\"median = {train['adr'].median():.0f}\")\n",
    "ax[0, 0].set_title(f\"Figure 5: ADR distribution (train, n = {n_tr:,}; capped at 400)\", fontsize=10)\n",
    "ax[0, 0].set_xlabel(\"ADR (average daily rate per night, currency not stated)\")\n",
    "ax[0, 0].set_ylabel(\"Number of bookings\"); ax[0, 0].legend()\n",
    "\n",
    "# Figure 6: cancellation counts\n",
    "cc = train[\"is_canceled\"].value_counts().sort_index()\n",
    "bars = ax[0, 1].bar([\"Not canceled (0)\", \"Canceled (1)\"], cc.values, color=[\"#55A868\", \"#C44E52\"])\n",
    "for b, v in zip(bars, cc.values):\n",
    "    ax[0, 1].text(b.get_x() + b.get_width() / 2, v, f\"{v}\\n({v / n_tr:.1%})\", ha=\"center\", va=\"bottom\")\n",
    "ax[0, 1].set_title(f\"Figure 6: Cancellation counts (train, n = {n_tr:,})\")\n",
    "ax[0, 1].set_ylabel(\"Number of bookings\"); ax[0, 1].set_ylim(0, cc.max() * 1.18)\n",
    "\n",
    "# Figure 7: numerical predictor vs ADR (lead time)\n",
    "lead_bins = pd.cut(train[\"lead_time\"], [-1, 7, 30, 90, 180, 365, 800])\n",
    "binned = train.groupby(lead_bins, observed=True)[\"adr\"].agg([\"count\", \"mean\", \"median\"])\n",
    "ax[0, 2].scatter(train[\"lead_time\"], train[\"adr\"].clip(upper=400), s=6, alpha=0.25, color=\"#8172B3\")\n",
    "mids = [(iv.left + iv.right) / 2 for iv in binned.index]\n",
    "ax[0, 2].plot(mids, binned[\"mean\"], \"o-\", color=\"black\", label=\"mean ADR per lead-time bin\")\n",
    "ax[0, 2].set_title(f\"Figure 7: Lead time vs ADR (train, n = {n_tr:,})\", fontsize=10)\n",
    "ax[0, 2].set_xlabel(\"Lead time (days)\"); ax[0, 2].set_ylabel(\"ADR (capped at 400 for display)\"); ax[0, 2].legend()\n",
    "\n",
    "# Figure 8: cancellation rate by market segment\n",
    "seg = train.groupby(\"market_segment\", observed=True)[\"is_canceled\"].agg([\"count\", \"mean\"]).sort_values(\"mean\")\n",
    "seg = seg[seg[\"count\"] >= 5]\n",
    "ax[1, 0].barh([f\"{i} (n={n})\" for i, n in zip(seg.index, seg[\"count\"])], seg[\"mean\"], color=\"#CCB974\")\n",
    "ax[1, 0].set_title(\"Figure 8: Cancellation rate by market segment (train)\")\n",
    "ax[1, 0].set_xlabel(\"Share of bookings canceled\"); ax[1, 0].set_xlim(0, 1)\n",
