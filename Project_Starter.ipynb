    "# Look for hotels.csv in a few usual places (Colab upload, repo data/ folder, current folder)\n",
    "candidates = [\"hotels.csv\", \"data/hotels.csv\", \"/content/hotels.csv\"]\n",
    "csv_path = next((p for p in candidates if os.path.exists(p)), None)\n",
    "\n",
    "if csv_path is None:\n",
    "    try:\n",
    "        from google.colab import files          # only exists inside Colab\n",
    "        files.upload()                          # pick hotels.csv in the popup\n",
    "        csv_path = \"hotels.csv\"\n",
    "    except ImportError:\n",
    "        raise FileNotFoundError(\"hotels.csv not found - put it next to the notebook or in data/\")\n",
    "\n",
    "# keep_default_na=False + na_values=[] is on purpose. By default pandas turns the text \"NULL\"\n",
    "# and \"NA\" into real missing values. In this file \"NULL\" in agent/company means \"not applicable\"\n",
    "# (not \"unknown\"), so I want to read every literal as plain text and decide what each one means myself.\n",
    "raw_data = pd.read_csv(csv_path, keep_default_na=False, na_values=[], low_memory=False)\n",
    "\n",
    "# fingerprint of the untouched data - I re-check it at the end to prove raw_data never changed\n",
    "raw_fingerprint = int(pd.util.hash_pandas_object(raw_data, index=True).sum())\n",
    "\n",
    "print(\"loaded from:\", csv_path)\n",
    "print(\"shape      :\", raw_data.shape)\n",
    "print(\"\\ncolumns:\")\n",
    "print(list(raw_data.columns))\n",
    "print(\"\\nfive sample rows:\")\n",
    "display(raw_data.sample(5, random_state=RANDOM_STATE))"
   ]
