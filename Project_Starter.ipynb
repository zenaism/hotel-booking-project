   "source": [
    "train = parts[\"train\"]\n",
    "all_pred = pd.concat(parts.values())      # predictors only are looked at across partitions in this cell\n",
    "\n",
    "# ---- agent / company: is \"NULL\" a hidden missing value or a real \"not applicable\"?\n",
    "null_share = pd.DataFrame({\n",
    "    \"bookings\": train[\"market_segment\"].value_counts(),\n",
    "    \"agent NULL share\": train.groupby(\"market_segment\")[\"agent\"].apply(lambda s: (s == \"NULL\").mean()),\n",
    "    \"company NULL share\": train.groupby(\"market_segment\")[\"company\"].apply(lambda s: (s == \"NULL\").mean()),\n",
    "}).round(2)\n",
    "print(\"Share of 'NULL' agent/company by market segment (training rows):\")\n",
    "display(null_share)\n",
    "print(f\"overall NULL share in training  ->  agent: {(train['agent'] == 'NULL').mean():.1%},  company: {(train['company'] == 'NULL').mean():.1%}\")\n",
    "\n",
    "# ---- zero / other sentinel values that I want to look at before touching\n",
    "print(\"\\nSentinel-looking values (all partitions, predictor columns only):\")\n",
    "sentinel = pd.Series({\n",
    "    \"agent == '0'\": int((all_pred[\"agent\"] == \"0\").sum()),\n",
    "    \"company == '0'\": int((all_pred[\"company\"] == \"0\").sum()),\n",
    "    \"meal == 'Undefined'\": int((all_pred[\"meal\"] == \"Undefined\").sum()),\n",
    "    \"meal == 'SC' (no meal package)\": int((all_pred[\"meal\"] == \"SC\").sum()),\n",
    "    \"adults == 0\": int((all_pred[\"adults\"] == 0).sum()),\n",
    "    \"adults == 0 but children/babies > 0\": int(((all_pred[\"adults\"] == 0) & ((all_pred[\"children\"] + all_pred[\"babies\"]) > 0)).sum()),\n",
    "    \"lead_time == 0\": int((all_pred[\"lead_time\"] == 0).sum()),\n",
    "    \"is_repeated_guest == 1 but no previous bookings\": int(((all_pred[\"is_repeated_guest\"] == 1) & ((all_pred[\"previous_cancellations\"] + all_pred[\"previous_bookings_not_canceled\"]) == 0)).sum()),\n",
    "    \"is_repeated_guest == 0 but has previous bookings\": int(((all_pred[\"is_repeated_guest\"] == 0) & ((all_pred[\"previous_cancellations\"] + all_pred[\"previous_bookings_not_canceled\"]) > 0)).sum()),\n",
    "}).to_frame(\"rows\")\n",
    "display(sentinel)\n",
    "\n",
    "zero_adr = train[train[\"adr\"] == 0]\n",
    "print(f\"\\nTraining rows with adr == 0: {len(zero_adr)} ({len(zero_adr) / len(train):.1%}). By market segment:\")\n",
    "display(zero_adr[\"market_segment\"].value_counts().to_frame(\"rows with adr 0\").join(\n",
    "    train[\"market_segment\"].value_counts().rename(\"all rows\")))\n",
    "display(zero_adr[[\"hotel\", \"market_segment\", \"customer_type\", \"stays_in_week_nights\", \"adults\", \"adr\"]].head(5))\n",
    "\n",
    "# ---- treatment\n",
    "n_meal = int((all_pred[\"meal\"] == \"Undefined\").sum())\n",
    "n_agent_null = int((all_pred[\"agent\"] == \"NULL\").sum())\n",
    "n_comp_null = int((all_pred[\"company\"] == \"NULL\").sum())\n",
    "for df in parts.values():\n",
    "    df[\"meal\"] = df[\"meal\"].replace({\"Undefined\": \"SC\"})            # dictionary: Undefined/SC both mean \"no meal package\"\n",
    "    df[\"agent\"] = df[\"agent\"].replace({\"NULL\": \"Not applicable\"})\n",
    "    df[\"company\"] = df[\"company\"].replace({\"NULL\": \"Not applicable\"})\n",
    "\n",
    "print(\"\\nAfter treatment:\")\n",
    "print(\"meal values  :\", sorted(pd.concat(parts.values())[\"meal\"].unique()))\n",
    "print(\"agent 'NULL' left:\", int((pd.concat(parts.values())[\"agent\"] == \"NULL\").sum()),\n",
    "      \"| company 'NULL' left:\", int((pd.concat(parts.values())[\"company\"] == \"NULL\").sum()))\n",
    "n_rows = sum(len(p) for p in parts.values())\n",
    "\n",
    "log_step(\"P2 special values\", \"meal = 'Undefined'\", n_meal, \"Merge into 'SC'\", \"The data dictionary says Undefined and SC both mean no meal package.\", n_rows)\n",
    "log_step(\"P2 special values\", \"agent = 'NULL'\", n_agent_null, \"Relabel 'Not applicable' (keep category)\", \"NULL means no travel agent was involved, mostly direct/corporate bookings - a real state, not a gap.\", n_rows)\n",
    "log_step(\"P2 special values\", \"company = 'NULL'\", n_comp_null, \"Relabel 'Not applicable' (keep category)\", \"NULL means no company paid/booked; this is the normal case, not missing data.\", n_rows)\n",
    "log_step(\"P2 special values\", \"agent / company coded 0\", 0, \"No treatment needed\", \"Checked: no '0' codes exist in either column, so no hidden sentinel there.\", n_rows)\n",
    "log_step(\"P2 special values\", \"adr == 0 (training rows: %d)\" % len(zero_adr), len(zero_adr), \"Retain\",\n",
    "         \"Many are Complementary / group rooms, so a zero rate is a real value (free stay), not a missing price. Marked as a limitation.\", n_rows)\n",
    "n_adults0 = int(sentinel.loc[\"adults == 0\", \"rows\"]); n_lead0 = int(sentinel.loc[\"lead_time == 0\", \"rows\"])\n",
    "n_flag = int(sentinel.iloc[-2:, 0].sum())\n",
    "log_step(\"P2 special values\", \"adults == 0 (all have children/babies)\", n_adults0, \"Retain\",\n",
    "         \"Children booked without an adult listed is odd but possible (e.g. teens/guests linked to another booking); guests are present, so the stay is real.\", n_rows)\n",
    "log_step(\"P2 special values\", \"lead_time == 0 (same-day booking)\", n_lead0, \"Retain\", \"A 0 here is a genuine value (booked on the arrival day), not a placeholder.\", n_rows)\n",
    "log_step(\"P2 special values\", \"is_repeated_guest flag disagrees with booking history\", n_flag, \"Retain, document only\",\n",
    "         \"Source quirk: flag and history counts come from different fields; no way to tell which is right, so neither is overwritten.\", n_rows)"
   ]
  },
