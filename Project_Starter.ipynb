    "month_num = {m: i for i, m in enumerate(MONTHS, 1)}\n",
    "\n",
    "def build_arrival_date(df):\n",
    "    return pd.to_datetime({\"year\": df[\"arrival_date_year\"],\n",
    "                           \"month\": df[\"arrival_date_month\"].astype(str).map(month_num),\n",
    "                           \"day\": df[\"arrival_date_day_of_month\"]}, errors=\"coerce\")\n",
    "\n",
    "def iso_week(d):\n",
    "    return d.dt.isocalendar().week.astype(\"float\")\n",
    "\n",
    "def sunday_week(d):\n",
    "    # weeks start on Sunday and week 1 is the week that contains 1 January\n",
    "    jan1 = pd.to_datetime({\"year\": d.dt.year, \"month\": 1, \"day\": 1})\n",
    "    return ((d.dt.dayofyear - 1) + (jan1.dt.dayofweek + 1) % 7) // 7 + 1\n",
    "\n",
    "# 1) every row of the full raw file\n",
    "all_dates = build_arrival_date(raw_data)\n",
    "check_rows = {\"full raw file\": (all_dates, raw_data[\"arrival_date_week_number\"])}\n",
    "for k, p in parts.items():\n",
    "    check_rows[k] = (build_arrival_date(p), p[\"arrival_date_week_number\"])\n",
    "\n",
    "date_check = pd.DataFrame({\n",
    "    name: {\"rows\": len(w),\n",
    "           \"invalid dates (e.g. 31 Apr, 30 Feb)\": int(d.isna().sum()),\n",
    "           \"week differs from ISO week\": int((iso_week(d) != w).sum()),\n",
    "           \"week differs from Sunday-start rule\": int((sunday_week(d) != w).sum()),\n",
    "           \"earliest arrival\": d.min().date(), \"latest arrival\": d.max().date()}\n",
    "    for name, (d, w) in check_rows.items()}).T\n",
    "display(date_check)\n",
    "\n",
    "# 2) look at actual disagreeing rows\n",
    "sample_dates = build_arrival_date(parts[\"train\"])\n",
    "disagree = parts[\"train\"].assign(arrival_date=sample_dates, iso_week=iso_week(sample_dates))\n",
    "disagree = disagree[disagree[\"iso_week\"] != disagree[\"arrival_date_week_number\"]]\n",
    "print(f\"Training rows where supplied week != ISO week: {len(disagree)} of {len(parts['train'])}. Examples:\")\n",
    "display(disagree[[\"arrival_date\", \"arrival_date_week_number\", \"iso_week\"]].head(6))\n",
    "\n",
    "# 3) the week numbers per year (supplied) - does week 53 only show up when it should?\n",
    "print(\"max supplied week by year:\", raw_data.groupby(\"arrival_date_year\")[\"arrival_date_week_number\"].max().to_dict())\n",
    "\n",
    "# 4) apply: add real dates and a weekday feature, no rows removed\n",
    "for df in parts.values():\n",
    "    df[\"arrival_date\"] = build_arrival_date(df)\n",
    "    df[\"arrival_weekday\"] = pd.Categorical(df[\"arrival_date\"].dt.day_name(),\n",
    "                                           categories=[\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"])\n",
    "assert all(df[\"arrival_date\"].notna().all() for df in parts.values())\n",
    "display(parts[\"train\"][[\"arrival_date_year\", \"arrival_date_month\", \"arrival_date_day_of_month\", \"arrival_date\", \"arrival_weekday\", \"arrival_date_week_number\"]].head(5))\n",
    "\n",
    "n_rows = sum(len(p) for p in parts.values())\n",
    "n_iso_all = int(date_check.loc[\"full raw file\", \"week differs from ISO week\"])\n",
    "n_iso_smp = int(date_check.loc[[\"train\", \"val\", \"test\"], \"week differs from ISO week\"].sum())\n",
    "n_bad_smp = int(date_check.loc[[\"train\", \"val\", \"test\"], \"invalid dates (e.g. 31 Apr, 30 Feb)\"].sum())\n",
    "log_step(\"P4 dates\", \"Invalid year/month/day combinations\", n_bad_smp, \"No treatment needed\",\n",
    "         \"Checked all 119,390 raw rows too: every combination is a real calendar date.\", n_rows)\n",
    "log_step(\"P4 dates\", \"Supplied week number differs from ISO week\", n_iso_smp, \"Retain supplied week\",\n",
    "         f\"{n_iso_all:,} of 119,390 raw rows differ from ISO, but 0 differ from a Sunday-start / week-1-contains-Jan-1 rule, so the column is consistent, just not ISO.\", n_rows)\n",
    "log_step(\"P4 dates\", \"Need a usable arrival date / weekday\", n_rows, \"Add arrival_date and arrival_weekday\",\n",
    "         \"Built from year/month/day after validation; weekday is a legitimate timing feature.\", n_rows)"
