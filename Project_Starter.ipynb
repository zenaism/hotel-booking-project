   "source": [
    "train = parts[\"train\"]\n",
    "OUTLIER_PRED = [\"lead_time\", \"stays_in_weekend_nights\", \"stays_in_week_nights\", \"adults\", \"children\", \"babies\",\n",
    "                \"previous_cancellations\", \"previous_bookings_not_canceled\"]\n",
    "\n",
    "# thresholds learned from TRAINING rows only\n",
    "q = train[OUTLIER_PRED + [\"adr\"]].quantile([0.25, 0.75, 0.99, 0.999]).T\n",
    "q.columns = [\"q1\", \"q3\", \"p99\", \"p99.9\"]\n",
    "q[\"tukey_upper_3xIQR\"] = q[\"q3\"] + 3 * (q[\"q3\"] - q[\"q1\"])\n",
    "q[\"train_max\"] = train[OUTLIER_PRED + [\"adr\"]].max()\n",
    "q[\"train_min\"] = train[OUTLIER_PRED + [\"adr\"]].min()\n",
    "print(\"Empirical thresholds from the training partition:\")\n",
    "display(q.round(2))\n",
    "\n",
    "caps = {c: float(np.ceil(q.loc[c, \"p99.9\"])) for c in OUTLIER_PRED}     # cap predictors at the training 99.9th percentile\n",
    "print(\"caps used for predictors:\", caps)\n",
    "\n",
    "# how many values would be clipped in each partition\n",
    "clip_counts = pd.DataFrame({k: {c: int((p[c] > caps[c]).sum()) for c in OUTLIER_PRED} for k, p in parts.items()})\n",
    "print(\"\\nValues above the cap, per partition:\")\n",
    "display(clip_counts)\n",
    "\n",
    "# actual extreme rows (training)\n",
    "print(\"Most extreme training rows by adults / lead time / nights:\")\n",
    "display(train.sort_values([\"adults\", \"lead_time\"], ascending=False)[\n",
    "    [\"hotel\", \"lead_time\", \"stays_in_weekend_nights\", \"stays_in_week_nights\", \"adults\", \"children\", \"babies\", \"market_segment\", \"adr\"]].head(5))\n",
    "\n",
    "adr_hi = train[train[\"adr\"] > q.loc[\"adr\", \"tukey_upper_3xIQR\"]]\n",
    "print(f\"\\nTraining rows with adr above the 3xIQR fence ({q.loc['adr', 'tukey_upper_3xIQR']:.0f}): {len(adr_hi)}; highest adr in training = {train['adr'].max():.0f}\")\n",
    "display(adr_hi[[\"hotel\", \"arrival_date_month\", \"market_segment\", \"adr\"]].sort_values(\"adr\", ascending=False).head(5))\n",
    "print(\"lead_time > 365 in training:\", int((train[\"lead_time\"] > 365).sum()), \"| total nights > 14 in training:\",\n",
    "      int(((train[\"stays_in_weekend_nights\"] + train[\"stays_in_week_nights\"]) > 14).sum()))\n",
    "\n",
    "# treatment: clip predictors only (never the target) at the training caps, same caps for val/test\n",
    "before_max = pd.DataFrame({k: p[OUTLIER_PRED].max() for k, p in parts.items()})\n",
    "for df in parts.values():\n",
    "    for c, cap in caps.items():\n",
    "        df[c] = df[c].clip(upper=int(cap))\n",
    "after_max = pd.DataFrame({k: p[OUTLIER_PRED].max() for k, p in parts.items()})\n",
    "print(\"\\nMax value per partition before -> after clipping:\")\n",
    "display(before_max.astype(str) + \" -> \" + after_max.astype(str))\n",
    "\n",
    "n_rows = sum(len(p) for p in parts.values())\n",
    "total_clipped = int(clip_counts.values.sum())\n",
    "log_step(\"P5 outliers\", \"Extreme lead time / stay / guest / history counts\", total_clipped,\n",
    "         \"Clip predictors at the training 99.9th percentile\", \"Values are rare but real; clipping limits their pull on scaled models without deleting rows.\", n_rows)\n",
    "log_step(\"P5 outliers\", \"Unusually high adr (training rows above 3xIQR fence: %d)\" % len(adr_hi), len(adr_hi),\n",
    "         \"Retain, target not modified\", \"High rates in peak-season/suite bookings are plausible; changing the target would hide real error. MAE is used for model selection because it is less sensitive to them.\", n_rows)\n",
    "log_step(\"P5 outliers\", \"Rows removed for outliers\", 0, \"None\", \"Deleting rows would change the shared split membership; more deletion is not better cleaning.\", n_rows)"
   ]
